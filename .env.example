# Copie para .env e preencha com seus valores. Nunca commite o arquivo .env.

# URL base da API de ponto/RH (sem barra no final). Os scripts concatenam /external_api/v1/reports/...
HR_API_BASE_URL=https://IP_SERVIDOR_OXEN
HR_API_ACCESS_TOKEN=YOUR_HR_API_ACCESS_TOKEN

# Microsoft SQL Server (ODBC Driver 18)
DB_SERVER=IP_SERVIDOR_OXEN
DB_DATABASE=oxen_rh
DB_USERNAME=seu_usuario_sql
DB_PASSWORD=YOUR_DB_PASSWORD
